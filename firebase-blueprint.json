{
  "entities": {
    "UserApiKey": {
      "title": "User API Key",
      "description": "API keys generated by users for VOID AI developer platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "key": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastUsedAt": { "type": "number" }
      },
      "required": ["id", "userId", "name", "key", "createdAt"]
    }
  },
  "firestore": {
    "/user_api_keys/{keyId}": {
      "schema": { "$ref": "#/entities/UserApiKey" },
      "description": "User API key records"
    }
  }
}
