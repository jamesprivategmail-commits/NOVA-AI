{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__route=/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api?__route=/auth/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api?__route=/v1/:path*"
    },
    {
      "source": "/((?!api|v1|auth|assets|public|void-logo\\.jpg|void-wallpaper\\.jpg|manifest\\.json|sw\\.js|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
